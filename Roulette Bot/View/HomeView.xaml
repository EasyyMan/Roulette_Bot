<UserControl x:Class="Roulette_Bot.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Roulette_Bot.View"
             xmlns:viewmodels="clr-namespace:MVVM_Core.ViewModels;assembly=MVVM_Core" 
             xmlns:helper="clr-namespace:Roulette_Bot.Helpers"
             d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dashboard" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryText}" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Bot Log" Style="{StaticResource HeaderStyle}"/>

                <Border Grid.Row="1" 
                        CornerRadius="6" 
                        Padding="3"
                        Background="{StaticResource InputBackground}">

                    <RichTextBox x:Name="Log" 
                                 FontFamily="Consolas" 
                                 IsReadOnly="True" 
                                 Background="{StaticResource InputBackground}"
                                 BorderBrush="{StaticResource InputBackground}"
                                 BorderThickness="0" 
                                 FocusVisualStyle="{x:Null}"
                                 helper:RichTextBoxHelper.LogEntries="{Binding LogEntries, Mode=OneWay}">

                    </RichTextBox>
                </Border>

            </Grid>
        </Border>


        <Button Grid.Row="2" 
                Content="STOP BOT" 
                Style="{StaticResource StopBtnStyle}"
                Command="{Binding StopBotCommand}"
                Visibility="{Binding IsBotRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Button Grid.Row="2" 
                Content="START BOT"
                Style="{StaticResource StartBtnStyle}"
                Command="{Binding StartBotCommand}"
                Visibility="{Binding IsBotRunning, Converter={StaticResource BooleanToVisibilityInverseConverter}}"/>

    </Grid>
</UserControl>
