<UserControl x:Class="Roulette_Bot.View.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Roulette_Bot.View"
             xmlns:helper="clr-namespace:Roulette_Bot.Helpers" 
             xmlns:viewmodels="clr-namespace:MVVM_Core.ViewModels;assembly=MVVM_Core" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="4500" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4, 5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Normal"/>

        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="23.9"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E7E7E7"/>

        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="23.9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E7E7E7"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

    </UserControl.Resources>


    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">

            <ScrollViewer.Resources>
                <!-- === DARK SCROLLBAR WITH VISIBLE ARROWS ON BOTH ENDS === -->
                <SolidColorBrush x:Key="DarkTrack" Color="#1E1E1E" />
                <SolidColorBrush x:Key="DarkThumb" Color="#555555" />
                <SolidColorBrush x:Key="DarkThumbHover" Color="#777777" />
                <SolidColorBrush x:Key="DarkThumbPressed" Color="#999999" />

                <SolidColorBrush x:Key="DarkButton" Color="#252525" />
                <SolidColorBrush x:Key="DarkButtonHover" Color="#3A3A3A" />
                <SolidColorBrush x:Key="DarkButtonPressed" Color="#505050" />
                <SolidColorBrush x:Key="ArrowColor" Color="#D0D0D0" />

                <!-- Arrow Button Style – arrows stay visible even when disabled -->
                <Style x:Key="ScrollArrowButton" TargetType="RepeatButton">
                    <Setter Property="Background" Value="{StaticResource DarkButton}" />
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Hover / Press -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource DarkButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource DarkButtonPressed}" />
                        </Trigger>
                        <!-- Keep arrows visible when at end point (disabled) -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="16" />
                    <!-- wider = cleaner arrows -->
                    <Setter Property="Background" Value="{StaticResource DarkTrack}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">

                                        <!-- ↑ Top / Left Arrow (always visible) -->
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollArrowButton}" 
                                                  Command="ScrollBar.LineUpCommand">
                                                <Path Data="M 0,9 L 11,9 L 5.5,2 Z" 
                                              Fill="{StaticResource ArrowColor}"
                                              Width="11" Height="10"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>

                                        <!-- Thumb -->
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Background="{StaticResource DarkThumb}">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5" 
                                                        Margin="3,1" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>

                                        <!-- ↓ Bottom / Right Arrow (always visible) -->
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollArrowButton}" 
                                                  Command="ScrollBar.LineDownCommand">
                                                <Path Data="M 0,2 L 11,2 L 5.5,9 Z" 
                                              Fill="{StaticResource ArrowColor}"
                                              Width="11" Height="10"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Thumb" Property="Background" Value="{StaticResource DarkThumbHover}" />
                                    </Trigger>
                                    <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                                        <Setter TargetName="Thumb" Property="Background" Value="{StaticResource DarkThumbPressed}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>


            <Grid  IsEnabled="{Binding IsUiEnabled}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryText}" />

                <StackPanel Grid.Row="1" Margin="0,0,20,0">

                    <!-- #region Cafe Casino Account -->

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Cafe Casino Account:" Style="{StaticResource HeaderStyle}"/>

                            <!-- Email -->
                            <TextBlock Text="Email" 
                                       Margin="4,12,0,5" 
                                       Foreground="{StaticResource SecondaryText}" 
                                       FontSize="12"/>

                            <TextBox Text="{Binding CurrentSettings.Email, 
                                            UpdateSourceTrigger=PropertyChanged, 
                                            Mode=TwoWay}"
                                     
                                     Margin="4,0,0,15"/>

                            <!-- Password -->
                            <TextBlock Text="Password" 
                                       Margin="4,0,0,5" 
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="12"/>
                            <PasswordBox helper:PasswordBoxHelper.BindPassword="True"
                                         helper:PasswordBoxHelper.BoundPassword="{Binding CurrentSettings.Password, Mode=TwoWay}"
                                         Margin="4,0,0,20"/>        


                            <!-- Buttons (Load button removed) -->
                            <StackPanel Orientation="Horizontal" 
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Button Content="Cancel" 
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,10,0"/>

                                <Button Content="Save" 
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #endregion -->

                    <!-- #region Play Mode -->

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Play Mode:" Style="{StaticResource HeaderStyle}"/>
                            <StackPanel>
                                <RadioButton Name="RealPlay"  
                                             Content="Real Play"
                                             Command="{Binding SelectRealPlayCommand}"
                                             IsChecked="{Binding PlayModeSelected, 
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter={x:Static viewmodels:PlayMode.RealPlay},
                                                         Mode=TwoWay}"/>
                                
                                <RadioButton Name="PracticePlay" 
                                             Content="Practice Play" 
                                             Command="{Binding SelectPracticePlayCommand}"
                                             IsChecked="{Binding PlayModeSelected, 
                                                         Converter={StaticResource EnumToBoolConverter},
                                                         ConverterParameter={x:Static viewmodels:PlayMode.PracticePlay},
                                                         Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #endregion -->

                    <!-- #region Stop Operating After -->

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Stop Operating After:" Style="{StaticResource HeaderStyle}"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" ></RowDefinition>
                                    <RowDefinition Height="Auto" ></RowDefinition>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Margin="2" Padding="3" BorderBrush="#FF080101">
                                    <StackPanel>
                                        <RadioButton Name="DurationOfTime" 
                                                     Content="Duration Of Time"
                                                     Command="{Binding SelectDurationOfTimeCommand}"
                                                     IsChecked="{Binding StopOperatingAfterSelectedMode, 
                                                                Converter={StaticResource EnumToBoolConverter},
                                                                ConverterParameter={x:Static viewmodels:StopOperatingAfterMode.DurationOfTime},
                                                                Mode=TwoWay}"/>
                                                                  
                                        
                                        <RadioButton Name="DollarAmountWon" 
                                                     Content="$ Amount Won (Profit marker)" 
                                                     Command="{Binding SelectDollarAmountWonCommand}"
                                                     IsChecked="{Binding StopOperatingAfterSelectedMode, 
                                                                Converter={StaticResource EnumToBoolConverter},
                                                                ConverterParameter={x:Static viewmodels:StopOperatingAfterMode.DollarAmountWon},
                                                                Mode=TwoWay}"
                                                     d:IsChecked="True"/>
                                    </StackPanel>
                                </Border>


                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Name="DurationPanel" 
                                                Grid.Column="0" 
                                                Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <!-- Default state is hidden -->
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <!-- When DollarAmountWon is checked, make it visible -->
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=DurationOfTime}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Label Margin="23,0,0,0" >After</Label>
                                        <TextBox Name="Duration"
                                                 Width="52"
                                                 Margin="7,0,0,0"
                                                 TextAlignment="Center"
                                                 MaxLength="4"                                      
                                                 Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="Duration_PreviewTextInput"
                                                 DataObject.Pasting="Duration_Pasting" />       
                                    </StackPanel>

                                    <ComboBox Name="TimeSet1"
                                              Grid.Column="1"
                                              Margin="30,3,3,3"
                                              FontFamily="Arial"
                                              FontSize="14"
                                              FontWeight="Normal"
                                              Visibility="{Binding IsDurationOfTime, Converter={StaticResource BooleanToVisibilityConverter}}"          
                                              ItemsSource="{Binding TimeUnits}"
                                              SelectedItem="{Binding SelectedDurationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>


                                    <StackPanel Name="DollarWonPanel" 
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                        
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <!-- Default state is hidden -->
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <!-- When DollarAmountWon is checked, make it visible -->
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=DollarAmountWon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>


                                        <Label Margin="23,0,0,0" >$ Amount</Label>

                                        <TextBox Name="Dollar"
                                                 Width="52"
                                                 Margin="7,0,0,0"
                                                 TextAlignment="Center"
                                                 MaxLength="10"
                                                 Text="{Binding Dollar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="Dollar_PreviewTextInput"
                                                 DataObject.Pasting="Dollar_Pasting" />

                                    </StackPanel>

                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- #endregion -->

                    <!-- #region Then Start Operating Again After -->

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Then Start Operating Again After:" Style="{StaticResource HeaderStyle}"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" ></RowDefinition>
                                    <RowDefinition Height="Auto" ></RowDefinition>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Margin="2" Padding="3" BorderBrush="#FF080101">
                                    <StackPanel>
                                        <RadioButton Name="FixedInterval" 
                                                     Content="Fixed Intervals"
                                                     Command="{Binding SelectFixedIntervalCommand}"
                                                     IsChecked="{Binding ThenStartOperatingAgainAfterSelectedMode, 
                                                                  Converter={StaticResource EnumToBoolConverter},
                                                                  ConverterParameter={x:Static viewmodels:ThenStartOperatingAgainAfterMode.FixedInterval},
                                                                  Mode=TwoWay}"/>
                                        
                                        <RadioButton Name="RandomInterval" 
                                                     Content="Random Intervals"
                                                     Command="{Binding SelectRandomIntervalCommand}"
                                                     IsChecked="{Binding ThenStartOperatingAgainAfterSelectedMode, 
                                                                 Converter={StaticResource EnumToBoolConverter},
                                                                 ConverterParameter={x:Static viewmodels:ThenStartOperatingAgainAfterMode.RandomInterval},
                                                                 Mode=TwoWay}"
                                                     d:IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Name="RandomPanel" 
                                                Orientation="Horizontal" 
                                                Grid.Column="0">
                                        
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <!-- Default state is hidden -->
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <!-- When RandomInterval is checked, make it visible -->
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=RandomInterval}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Label  Margin="23,0,0,0" >Between</Label>
                                        
                                        <TextBox Name="Btwn1"
                                                 Width="52"
                                                 Margin="4,0,4,0"
                                                 TextAlignment="Center"
                                                 MaxLength="4"
                                                 Text="{Binding Btwn1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="Btwn1_PreviewTextInput"
                                                 DataObject.Pasting="Btwn1_Pasting" />


                                        <Label>and</Label>
                                        <TextBox Name="Btwn2"
                                                 Width="52"
                                                 Margin="7,0,0,0"
                                                 TextAlignment="Center"
                                                 MaxLength="4"
                                                 Text="{Binding Btwn2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="Btwn2_PreviewTextInput"
                                                 DataObject.Pasting="Btwn2_Pasting" />  

                                    </StackPanel>

                                    <StackPanel Name="FixedPanel"
                                                Grid.Column="0" 
                                                Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <!-- Default state is hidden -->
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <!-- When FixedInterval is checked, make it visible -->
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FixedInterval}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>


                                        <Label Margin="23,0,0,0" >After every</Label>
                                        <TextBox Name="FixedEvery"
                                                 Width="52"
                                                 Margin="7,0,0,0"
                                                 TextAlignment="Center"
                                                 MaxLength="4"
                                                 Text="{Binding FixedEvery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="FixedEvery_PreviewTextInput"
                                                 DataObject.Pasting="FixedEvery_Pasting" /> 
                                    </StackPanel>

                                    <ComboBox Name="TimeSet2" 
                                              Grid.Column="1" 
                                              Margin="30,3,3,3" 
                                              FontFamily="Arial"
                                              FontSize="14"
                                              FontWeight="Normal"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding TimeUnits}"
                                              SelectedItem="{Binding SelectedTimeSet2Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                </Grid>
                            </Grid>

                        </StackPanel>
                    </Border>
                    <!-- #endregion -->

                    <!--#region Bet On-->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Bet On:" Style="{StaticResource HeaderStyle}"/>

                            <Border Margin="2" Padding="3">
                                <StackPanel>
                                    <RadioButton x:Name="Feature_1_Option_A_RadioButton"
                                                 Content="1-18,  Even,  Red,  Black,  Odd,  19-36"
                                                 Command="{Binding Set_BetOn_Option_1Command}"
                                                 IsChecked="{Binding BetOnMode, 
                                                              Converter={StaticResource EnumToBoolConverter},
                                                              ConverterParameter={x:Static viewmodels:BetOn.Option_1},
                                                              Mode=TwoWay}"
                                                 d:IsChecked="True"/>

                                    <RadioButton x:Name="Feature_1_Option_B_RadioButton"
                                                 Content="1st 12,  2nd 12,  3rd 12,  top 2:1,  mid 2:1,  bottom 2:1"
                                                 Command="{Binding Set_BetOn_Option_2Command}"
                                                 IsChecked="{Binding BetOnMode, 
                                                            Converter={StaticResource EnumToBoolConverter},
                                                            ConverterParameter={x:Static viewmodels:BetOn.Option_2},
                                                            Mode=TwoWay}"/>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                    <!--#endregion-->

                    <!--#region $ Bet Mark Amount To Reset To $1   -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="$ Bet Mark Amount To Reset To $1:" Style="{StaticResource HeaderStyle}"/>

                            <StackPanel Orientation="Horizontal">

                                <Label  Margin="23,0,0,0" >$ Amount</Label>

                                <TextBox Name="ResetMarkAmount"
                                         Width="52"
                                         Margin="4,0,4,0"
                                         TextAlignment="Center"
                                         MaxLength="5"
                                         Text="{Binding ResetMarkAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="ResetMarkAmount_PreviewTextInput"
                                         DataObject.Pasting="ResetMarkAmount_Pasting" 
                                         d:Text="486"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!--#endregion-->

                    <!-- #region Implement Random Bet Every Time -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding IsChecked, ElementName=Feature_1_Option_A_RadioButton, 
                                        Converter={StaticResource BoolToVis}}">
                        
                        <StackPanel>
                            <TextBlock Text="Implement Random Bet Every Time:" Style="{StaticResource HeaderStyle}"/>

                            <Border Margin="2" Padding="3">

                                <StackPanel>

                                    <RadioButton Content="Yes"
                                                 Command="{Binding SetEveryTimeRandomBetCommand}"
                                                 IsChecked="{Binding RandomBetMode, 
                                                              Converter={StaticResource EnumToBoolConverter},
                                                              ConverterParameter={x:Static viewmodels:RandomBetType.EveryTime},
                                                              Mode=TwoWay}"
                                                 d:IsChecked="False"/>

                                    <RadioButton Content="No"
                                                 Command="{Binding SetDuringWinsRandomBetCommand}"
                                                 IsChecked="{Binding RandomBetMode, 
                                                              Converter={StaticResource EnumToBoolConverter},
                                                              ConverterParameter={x:Static viewmodels:RandomBetType.During_Wins},
                                                              Mode=TwoWay}"
                                                 d:IsChecked="True"/>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- #endregion -->



                    <StackPanel Visibility="{Binding IsChecked, ElementName=Feature_1_Option_B_RadioButton, 
                                            Converter={StaticResource BoolToVis}}">

                        <!--#region Bet On 12 Sets-->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="If 'Bet On' Option (1st 12,  2nd 12,  3rd 12,  top 2:1,  mid 2:1,  bottom 2:1) is selected:" Style="{StaticResource HeaderStyle}"/>


                                <Border Margin="2" Padding="3">
                                    <StackPanel>
                                        <RadioButton Content="Bet on Both 12's Sets at the same Time"
                             Command="{Binding Set_BetOn12section_Both_SetsCommand}"
                             IsChecked="{Binding BetOn12sectionMode, 
                                          Converter={StaticResource EnumToBoolConverter},
                                          ConverterParameter={x:Static viewmodels:BetOn12section.BetOn_Both_Sets},
                                          Mode=TwoWay}"
                             d:IsChecked="True"/>

                                        <RadioButton Content="Bet on 1 of the 12's Sets at a Time"
                             Command="{Binding Set_BetOn12section_1_Set_At_A_TimeCommand}"
                             IsChecked="{Binding BetOn12sectionMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:BetOn12section.BetOn_1_Set_At_A_Time},
                                        Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!--#endregion-->

                        <!--#region Random Bets -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="If 'Bet On' Option (1st 12,  2nd 12,  3rd 12,  top 2:1,  mid 2:1,  bottom 2:1) is selected:" Style="{StaticResource HeaderStyle}"/>
                                <TextBlock Text="And If (Bet on 1 of the 12's Sets at a Time) is selected:" Style="{StaticResource HeaderStyle}"/>


                                <Border Margin="2" Padding="3">
                                    <StackPanel>
                                        <RadioButton Content="Bet on the Same 2 Individual Bets Every Bet"
                             Command="{Binding Set_RandomBet_12section_SameBets_EveryTimeCommand}"
                             IsChecked="{Binding RandomBet_12SectionMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:RandomBet_12section.BetOn_SameBets_EveryTime},
                                        Mode=TwoWay}"
                             d:IsChecked="True"/>

                                        <RadioButton Content="Bet on Random 2 Bets Every Bet"
                             Command="{Binding Set_RandomBet_12section_RandomBets_EveryTimeCommand}"
                             IsChecked="{Binding RandomBet_12SectionMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:RandomBet_12section.BetOn_RandomBets_EveryTime},
                                        Mode=TwoWay}"/>

                                        <RadioButton Content="Bet on Random 2 Bets Every Time it Wins"
                             Command="{Binding Set_RandomBet_12section_RandomBets_DuringWinsCommand}"
                             IsChecked="{Binding RandomBet_12SectionMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:RandomBet_12section.BetOn_RandomBets_DuringWins},
                                        Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!--#endregion-->

                        <!--#region Calculate Chip Amount -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="If 'Bet On' Option (1st 12,  2nd 12,  3rd 12,  top 2:1,  mid 2:1,  bottom 2:1) is selected:" Style="{StaticResource HeaderStyle}"/>
                                <TextBlock Text="And If (Bet on Both 12's Sets at the same Time) is selected:" Style="{StaticResource HeaderStyle}"/>

                                <Border Margin="2" Padding="3">
                                    <StackPanel>
                                        <RadioButton Content="Calculate per Chip amount by (highest balance - current balance) / 2" 
                             Command="{Binding Set_ChipAmountCalc_Option_1Command}"
                             IsChecked="{Binding ChipAmountCalcMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:ChipAmountCalc.Option_1},
                                        Mode=TwoWay}"
                             d:IsChecked="True"/>

                                        <RadioButton Content="Calculate per Chip amount by ((highest balance - current balance) + 1 ) / 2"
                             Command="{Binding Set_ChipAmountCalc_Option_2Command}"
                             IsChecked="{Binding ChipAmountCalcMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:ChipAmountCalc.Option_2},
                                        Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!--#endregion-->

                        <!--#region Calculate Chip Amount 2-->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="If 'Bet On' Option (1st 12,  2nd 12,  3rd 12,  top 2:1,  mid 2:1,  bottom 2:1) is selected:" Style="{StaticResource HeaderStyle}"/>
                                <TextBlock Text="And If (Bet on 1 of the 12's Sets at a Time) is selected:" Style="{StaticResource HeaderStyle}"/>

                                <Border Margin="2" Padding="3">
                                    <StackPanel>
                                        <RadioButton Content="Double the Chip Amount after each loss. Reset when it wins."                           
                                                     Command="{Binding Set_ChipAmountCalc_12section_SimpleDoubleCommand}"
                                                     IsChecked="{Binding ChipAmountCalc_12sectionMode, 
                                                                Converter={StaticResource EnumToBoolConverter},
                                                                ConverterParameter={x:Static viewmodels:ChipAmountCalc_12section.SimpleDouble},
                                                                Mode=TwoWay}"
                                                     d:IsChecked="True"/>
                                        <RadioButton Content="Double the Chip Amount after each loss and then add $1. Reset when it wins."
                             Command="{Binding Set_ChipAmountCalc_12section_DoublePlusOneCommand}"
                             IsChecked="{Binding ChipAmountCalc_12sectionMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:ChipAmountCalc_12section.DoublePlusOne},
                                        Mode=TwoWay}"/>
                                        <RadioButton Content="Double the Chip Amount after each loss, then add an extra dollar per loss. Reset when it wins."
                             Command="{Binding Set_ChipAmountCalc_12section_DoublePlusIncrementingDollarCommand}"
                             IsChecked="{Binding ChipAmountCalc_12sectionMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:ChipAmountCalc_12section.DoublePlusIncrementingDollar},
                                        Mode=TwoWay}"/>
                                        <RadioButton Content="Bet $1, double after first loss, then triple after each loss until it wins."
                             Command="{Binding Set_ChipAmountCalc_12section_DoubleThenTripleCommand}"
                             IsChecked="{Binding ChipAmountCalc_12sectionMode, 
                                        Converter={StaticResource EnumToBoolConverter},
                                        ConverterParameter={x:Static viewmodels:ChipAmountCalc_12section.DoubleThenTriple},
                                        Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!--#endregion-->

                    </StackPanel>

                    

                    <!-- #region Edit Yellow Boxes Positions -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding ShowEditYellowBoxesPositionsSection,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel>
                            <TextBlock Text="Edit Yellow Boxes Positions:" Style="{StaticResource HeaderStyle}"/>

                            <Border Margin="2" Padding="3">
                                <StackPanel>
                                    <RadioButton x:Name="EnableYellowBoxesRadioButton"
                             Content="Enable"
                             Command="{Binding EnableEditYellowBoxesCommand}"
                             IsChecked="{Binding YellowBoxesConfigType, 
                                          Converter={StaticResource EnumToBoolConverter},
                                          ConverterParameter={x:Static viewmodels:ConfigYellowBoxes.Enabled},
                                          Mode=TwoWay}"
                             d:IsChecked="False"/>


                                    <RadioButton Content="Disable"
                             Command="{Binding DisableEditYellowBoxesCommand}"
                             IsChecked="{Binding YellowBoxesConfigType, 
                                         Converter={StaticResource EnumToBoolConverter},
                                         ConverterParameter={x:Static viewmodels:ConfigYellowBoxes.Disabled},
                                         Mode=TwoWay}"
                             d:IsChecked="True">
                                    </RadioButton>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- #endregion -->

                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>


</UserControl>
