<Window x:Class="Roulette_Bot.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Roulette_Bot"
        mc:Ignorable="d"
        
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0E1822"
        Height="330" Width="420"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="DarkSplashProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1A2735"/>

            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00C6FF" Offset="0.0"/>
                        <GradientStop Color="#0072FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    HorizontalAlignment="Left"/>

                                <Border x:Name="IndeterminateIndicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Visibility="Hidden">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="IndicatorTransform" X="-100"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="IndeterminateIndicator" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndeterminateAnimation">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-100" To="350"
                                                         Duration="0:0:1.5"
                                                         AccelerationRatio="0.2"
                                                         DecelerationRatio="0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndeterminateAnimation"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">

            <!-- Edited logo with "Roulette Bot" text already on it -->
            <Image Source="/Icon/Roulette_Bot_Logo.png"
                   Width="280" 
                   Height="280"                    
                   Stretch="Uniform" />

            <!-- Material Design animated progress bar -->
            <ProgressBar IsIndeterminate="True" 
                         Height="10" 
                         Width="300" 
                         Margin="0,0,0,0" 
                         Style="{StaticResource DarkSplashProgressBar}"/>

        </StackPanel>
    </Grid>


</Window>
