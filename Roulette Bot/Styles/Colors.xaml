<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- classic stop red -->
    <SolidColorBrush x:Key="StopColor" Color="#E74C3C"/>

    <!-- darker hover red -->
    <SolidColorBrush x:Key="StopHover" Color="#C0392B"/>
    
    <SolidColorBrush x:Key="SidebarBackground" Color="#1E1F22"/>
    <SolidColorBrush x:Key="CardBackground" Color="#2B2D31"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#B5BAC1"/>
    <SolidColorBrush x:Key="AccentColor" Color="#23A559"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1F8B4C"/>
    <SolidColorBrush x:Key="InputBackground" Color="#111214"/>
    <SolidColorBrush x:Key="InputBorder" Color="#111214"/>

</ResourceDictionary>