<Window x:Class="Roulette_Bot.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Roulette_Bot"
        mc:Ignorable="d"
        Title="Bot Overlay" WindowStyle="None" AllowsTransparency="True" 
        Background="#22000000" Topmost="True" ShowInTaskbar="False" WindowState="Maximized">

    <Grid>
        <Border BorderBrush="Gray" BorderThickness="2">
            <!-- A control panel at the top to lock and start -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
            Background="White" Orientation="Horizontal" Margin="10" Panel.ZIndex="100">
                <TextBlock Text="Adjust your targets. When finished, press:" Foreground="Black" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                <Button Content="LOCK &amp; START PLAYING" Background="Green" Foreground="White" 
            FontWeight="Bold" Padding="20,10" Click="LockAndStart_Click"/>
            </StackPanel>
        </Border>
        

        <!-- The collection of bounding boxes -->
        <ItemsControl ItemsSource="{Binding TargetBoxes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- Bind the X and Y coordinates to the Canvas position -->
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>

                        <!-- The Visible Box -->
                        <Rectangle Stroke="{Binding HexColor}" 
                                   StrokeThickness="4"
                                   Fill="#33FFFFFF"
                                   Width="{Binding Width, Mode=TwoWay}"
                                   Height="{Binding Height, Mode=TwoWay}"
                                   />

                        <!-- Name Label -->
                        <TextBlock Text="{Binding Name}" Foreground="White" Background="Black" Padding="3"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,-20,0,0"/>

                        <!-- Drag Body -->
                        <Thumb Opacity="0" DragDelta="Body_DragDelta" Cursor="SizeAll"/>

                        <!-- Bottom Right Resize Handle -->
                        <Thumb Width="15" Height="15" Background="White" BorderBrush="Black" BorderThickness="1"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="-7"
                               DragDelta="Resize_DragDelta" Cursor="SizeNWSE"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
